# THULIR Environment Configuration Template
# Copy this file to .env and customize for your environment. Never commit .env with real credentials.

# Application Environment: development | production | test
# Note: Seed scripts refuse to run when APP_ENV=production.
APP_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Connection (Default SQLite for local dev & testing; PostgreSQL compatible)
DATABASE_URL=sqlite:///./thulir.db

# Authentication & Security
# Change SECRET_KEY to a high-entropy string in production (minimum 32 characters)
SECRET_KEY=thulir-secure-random-secret-key-replace-in-production-min-32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload Limit (in megabytes)
MAX_UPLOAD_SIZE_MB=5

# Initial Admin Bootstrap (Used by bootstrap script to seed the first school administrator)
FIRST_ADMIN_USERNAME=admin@kovilpatti.tnschools.gov.in
FIRST_ADMIN_PASSWORD=ChangeThisPassword123!
FIRST_ADMIN_NAME=R. Selvam (HM)
FIRST_ADMIN_SCHOOL_NAME=Government Higher Secondary School Kovilpatti
FIRST_ADMIN_UDISE=33280100412

